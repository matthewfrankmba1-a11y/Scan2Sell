# Copy to .env for local use (`npm start` reads it), or add these as
# Environment Variables in your Vercel project settings.

# ── Access keys (optional) ──────────────────────────────────────────────
# Setting ACCESS_KEY_SECRET locks the app: people need an access key, which
# they can request in Settings. Use a long random string (32+ characters) and
# keep it secret. Changing it invalidates every key already issued.
ACCESS_KEY_SECRET=
# Discord channel webhook that receives key requests with an Approve button.
DISCORD_WEBHOOK_URL=
# Email sender for approved keys. Brevo (brevo.com, free) can send from a
# verified Gmail address; Resend needs your own domain. Use one of the two.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Scan2Sell <you@gmail.com>
# Keys to block, comma-separated (e.g. S2S-ABCD-...).
REVOKED_KEYS=
# Optional master code that always works, for you.
APP_PASSWORD=

# eBay (developer.ebay.com → Application Keys → Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to true only after eBay approves your app for Marketplace Insights (sold prices)
EBAY_USE_SOLD=false

# StockX (developer.stockx.com). Get the refresh token from the app's Settings → Connect StockX.
STOCKX_API_KEY=
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_REFRESH_TOKEN=

# Optional paid UPCitemdb key (the free trial works without one, ~100 lookups/day)
UPCITEMDB_KEY=

# Optional: public URL if auto-detection is wrong behind a proxy (used for the StockX redirect)
PUBLIC_URL=
